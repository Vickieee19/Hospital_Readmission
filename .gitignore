# ═══════════════════════════════════════════════
#  .gitignore — CareGrid / Hospital Readmission
# ═══════════════════════════════════════════════

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Virtual environments ─────────────────────────
.venv/
venv/
env/
.env/
ENV/

# ── Environment variables / secrets ─────────────
.env
.env.local
.env.*.local
*.env

# ── Jupyter ──────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Datasets & ML artefacts (large files — use DVC or Git LFS)
dataset/*.parquet
dataset/*.json
models/charts/*.png
# Keep .gitkeep files so empty folders are tracked
!dataset/.gitkeep
!models/.gitkeep
# Catch-all for any other large binary formats
*.h5
*.hdf5
*.ckpt
*.pt
*.pth

# ── Output & log directories ─────────────────────
backend/outputs/
backend/logs/
mlruns/
runs/
outputs/
logs/

# ── OS generated ─────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / Editor ─────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# ── Node / Frontend ──────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/coverage/
frontend/.cache/
frontend/.parcel-cache/
frontend/.vite/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*
frontend/*.local

# ── Testing & coverage ───────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── Uploads, Personal Files & Test Reports ───────
uploads/
**/uploads/*.pdf
**/uploads/*
**/evaluation/reports/*.json

