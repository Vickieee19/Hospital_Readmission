# ─────────────────────────────────────────────────────────────────
#  Hospital Readmission & Clinical Severity — Environment Example
# ─────────────────────────────────────────────────────────────────

# Google Gemini API (Get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional Groq API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Vector Database & Embeddings Configuration
CHROMA_DB_PATH=./backend/rag/vectordb
KNOWLEDGE_BASE_PATH=./backend/rag/knowledge_base
UPLOADS_PATH=./backend/rag/uploads
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K_RESULTS=5
CHROMA_COLLECTION_NAME=medical_guidelines

# Server Configuration
HOST=0.0.0.0
PORT=8000
